# Copy to .env for local dev. .env, .env.test and .env.prod are gitignored.
# Ports are eam-specific so eam can run beside FreightClub (9090/9091/5173/5432).

# --- Postgres (dev) ---
# The dev Postgres volume keeps the initial passwords. After changing them, run
# `docker compose -f docker-compose.dev.yml down -v` to re-key.
EAM_DB_ADMIN_PASSWORD=change-me-admin
EAM_DB_RUNTIME_PASSWORD=change-me-runtime
EAM_DB_LOGIN_PASSWORD=change-me-login

# --- Auth ---
# HS256 signing key for access tokens, at least 32 bytes. The backend refuses to start if shorter.
# Generate one: openssl rand -base64 48
EAM_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes

# --- Host ports (dev) ---
EAM_DB_PORT=5433
EAM_BACKEND_PORT=8180
EAM_FRONTEND_PORT=5273

# --- Frontend ---
# Add the current Tailscale hostname here if you reach Vite through the tailnet.
VITE_ALLOWED_HOST=

{
  "permissions": {
    "allow": [
      "mcp__plugin_context-mode_context-mode__ctx_fetch_and_index",
      "mcp__plugin_context-mode_context-mode__ctx_search"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-raw-search-tools.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/story-scope-guard.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/visual-evidence-guard.sh"
          }
        ]
      }
    ]
  }
}
